# Public site origin (sitemap, feed, robots.txt, absolute links)
SITE_URL=https://rustkorea.kr
MAIL_DOMAIN=rustkorea.kr

# YouTube channel synced by the background worker
YOUTUBE_CHANNEL_ID=UCeVVCp2CRrcmUQ8SuvCdSyg
YOUTUBE_CHANNEL_NAME=Rust Korea

# Trusted Web Activity (Android). Fingerprints: comma-separated uppercase
# SHA-256 cert fingerprints (keytool or Play Console > Setup > App integrity).
# Leave empty until the Android app exists.
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/rustkorea

# First-boot admin (required once: creates role='admin' user if none exists.
# Must be 10+ chars and not "admin123"; remove after first boot.)
ADMIN_EMAIL=admin@rustkorea.kr
ADMIN_PASSWORD=

# GitHub OAuth (https://github.com/settings/developers)
# 1. New OAuth App > Homepage URL: http://localhost:3000
# 2. Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# 1. Create OAuth 2.0 Client ID > Authorized redirect URIs: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session cookies: Secure + __Host- prefix (HTTPS) by default.
# Set to 0 for plain-HTTP testing (browsers reject Secure cookies over http).
SECURE_COOKIES=1

# Emergency TOTP recovery: set to an admin email to disable its 2FA on
# next boot, then UNSET immediately after logging in.
TOTP_RESET_EMAIL=

# Set to 1 when serving HTTPS directly (marks OAuth state cookies Secure).
# Leave unset behind TLS-terminating proxies / local http.
OAUTH_SECURE_COOKIES=
